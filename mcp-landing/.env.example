NEXT_PUBLIC_WHATSAPP_NUMBER=5493425196295
NEXT_PUBLIC_GOOGLE_TAG_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO=AW-XXXXXXXXX/xxxxxxxxxxxxxxx
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Chatbot cotizador (solo servidor, sin prefijo NEXT_PUBLIC_)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini

# Base de datos del CRM (Neon). Las comillas importan: la URL lleva "&".
DATABASE_URL="postgresql://user:pass@host.neon.tech/neondb?sslmode=require"
# Sal para hashear IPs (anti-abuso sin guardar la IP). Generar con: openssl rand -hex 32
IP_HASH_SALT=xxxxxxxxxxxxxxxx

# Panel de admin (/admin). Sin estas dos, el login devuelve 503.
ADMIN_PASSWORD=cambiar-esta-clave
# Firma de la cookie de sesión. Generar con: openssl rand -hex 32
ADMIN_SESSION_SECRET=xxxxxxxxxxxxxxxx

# Opcional. Recibe cada lead de /api/lead y un aviso cuando una tarjeta sale
# "caliente" (Zapier / Make / Slack). Sin esto, el panel hay que abrirlo a mano.
LEAD_WEBHOOK_URL=https://hooks.zapier.com/xxxxxxxx

# Opcional. Aviso instantáneo por Telegram cuando alguien deja su teléfono en el
# chat de la web. Para obtenerlos:
#   1. Hablarle a @BotFather -> /newbot -> copiar el token.
#   2. Mandarle un mensaje cualquiera al bot nuevo.
#   3. Abrir https://api.telegram.org/bot<TOKEN>/getUpdates y copiar
#      result[0].message.chat.id
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789
